<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- 1. GAMBAR LATAR BELAKANG (TETAP SAMA) -->
    <ImageView
        android:id="@+id/ivBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/sun"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 2. HEADER LOKASI (TETAP SAMA) -->
    <TextView
        android:id="@+id/tvLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="Mencari Lokasi..."
        android:textColor="@android:color/white"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 3. INFORMASI SUHU UTAMA (TETAP SAMA) -->
    <TextView
        android:id="@+id/tvTemperature"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="80dp"
        android:text="--°"
        android:textColor="@android:color/white"
        android:textSize="96sp"
        android:fontFamily="sans-serif-light"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvLocation" />

    <TextView
        android:id="@+id/tvCondition"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:text="Memuat cuaca..."
        android:textColor="@android:color/white"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTemperature" />

    <TextView
        android:id="@+id/tvFeelsLike"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="24dp"
        android:text="Menghubungkan ke satelit GPS..."
        android:textColor="#D8FFFFFF"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvCondition" />

    <!-- 4. KARTU DETAIL CUACA (STRUKTUR TETAP SAMA, ISI BAWAHNYA KITA TAMBAHKAN CARD) -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_margin="24dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#26FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Ditambahkan ScrollView agar isi kartu detail baru di bawahnya bisa di-scroll ke bawah -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Sub-Header Di Dalam Kartu (TETAP SAMA) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@android:drawable/ic_menu_today"
                        app:tint="#B3FFFFFF" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Informasi &amp; Detail Cuaca"
                        android:textColor="#B3FFFFFF"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Grid Tampilan Hari ini & Besok (TETAP SAMA) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <!-- Informasi Hari Ini (TETAP SAMA) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:background="#1AFFFFFF"
                        android:padding="12dp"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hari ini" android:textColor="@android:color/white" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="21°/36°" android:textStyle="bold" android:textSize="16sp" android:textColor="@android:color/white" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cerah" android:textColor="#CCFFFFFF" />
                    </LinearLayout>

                    <!-- Informasi Besok (TETAP SAMA) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="#1AFFFFFF"
                        android:padding="12dp"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Besok" android:textColor="@android:color/white" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="20°/38°" android:textStyle="bold" android:textSize="16sp" android:textColor="@android:color/white" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cerah" android:textColor="#CCFFFFFF" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ======================================================== -->
                <!-- FITUR BARU: 5 KARTU DETAIL (MASUK DI BAWAH HARI INI/BESOK) -->
                <!-- ======================================================== -->

                <!-- Baris 1 Fitur: Humidity & Wind -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:background="#1AFFFFFF"
                        android:padding="12dp"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HUMIDITY" android:textSize="11sp" android:textColor="#CCFFFFFF" />
                        <TextView android:id="@+id/tvHumidity" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="75%" android:textStyle="bold" android:textSize="16sp" android:textColor="@android:color/white" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="#1AFFFFFF"
                        android:padding="12dp"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="WIND" android:textSize="11sp" android:textColor="#CCFFFFFF" />
                        <TextView android:id="@+id/tvWind" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="12 km/h" android:textStyle="bold" android:textSize="16sp" android:textColor="@android:color/white" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Baris 2 Fitur: UV Index & Pressure -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <!-- UV Index -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:background="#1AFFFFFF"
                        android:padding="12dp"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="UV INDEX"
                            android:textSize="11sp"
                            android:textColor="#CCFFFFFF" />
                        <TextView
                            android:id="@+id/tvUV"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3 (Mod)"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="@android:color/white" />
                    </LinearLayout>

                    <!-- Pressure -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="#1AFFFFFF"
                        android:padding="12dp"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PRESSURE"
                            android:textSize="11sp"
                            android:textColor="#CCFFFFFF" />
                        <TextView
                            android:id="@+id/tvPressure"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1012 hPa"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="@android:color/white" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Baris 3 Fitur: Visibility -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <!-- Visibility -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:background="#1AFFFFFF"
                        android:padding="12dp"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="VISIBILITY"
                            android:textSize="11sp"
                            android:textColor="#CCFFFFFF" />
                        <TextView
                            android:id="@+id/tvVisibility"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10 km"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="@android:color/white" />
                    </LinearLayout>

                    <!-- Sisi Kanan Dikosongkan Menggunakan View Transparan Agar Seimbang -->
                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
